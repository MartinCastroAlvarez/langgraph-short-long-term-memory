# Copy to .env (never commit it). Every variable is optional.
MEMORY_PROVIDER=ollama                  # ollama | anthropic | fake
MEMORY_MODEL=qwen3:4b                   # claude-sonnet-5-5 for anthropic
OLLAMA_HOST=http://127.0.0.1:11434      # loopback only unless the next line is 1
MEMORY_ALLOW_REMOTE_OLLAMA=
MEMORY_TEMPERATURE=0
MEMORY_EMBEDDINGS=ollama                # ollama | fastembed | hashing
MEMORY_EMBED_MODEL=nomic-embed-text
MEMORY_EMBED_DIMS=768
MEMORY_WRITE_MODE=both                  # hot | background | both
MEMORY_MAX_CONTEXT_TOKENS=3000
MEMORY_SUMMARIZE_AFTER_TOKENS=2000
MEMORY_KEEP_RECENT_TOKENS=600
MEMORY_SUMMARY_MAX_CHARS=1500
MEMORY_RECALL_FACTS=5
MEMORY_RECALL_EPISODES=2
MEMORY_DEDUP_THRESHOLD=0.9
# Only for the optional Anthropic adapter (pip install ".[anthropic]"):
# ANTHROPIC_API_KEY=
